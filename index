                                    </tr>
                                    <tr class="hover:bg-slate-50 transition-colors border-b border-slate-100 bg-slate-50/50">
                                        <td class="px-6 py-4 font-semibold text-slate-700">Impuls</td>
                                        <td class="px-6 py-4 font-mono font-bold text-primary">I = F &times; &Delta;t</td>
                                    </tr>
                                    <tr class="hover:bg-slate-50 transition-colors border-b border-slate-100">
                                        <td class="px-6 py-4 font-semibold text-slate-700">Hubungan Impuls-Momentum</td>
                                        <td class="px-6 py-4 font-mono font-bold text-primary">I = &Delta;p <span class="text-slate-400 font-sans mx-2">&rarr;</span> F &middot; &Delta;t = m(v<sub>akhir</sub> - v<sub>awal</sub>)</td>
                                    </tr>
                                    <tr class="hover:bg-slate-50 transition-colors border-b border-slate-100 bg-slate-50/50">
                                        <td class="px-6 py-4 font-semibold text-slate-700">Kekekalan Momentum</td>
                                        <td class="px-6 py-4 font-mono font-bold text-primary">m<sub>1</sub>v<sub>1</sub> + m<sub>2</sub>v<sub>2</sub> = m<sub>1</sub>v<sub>1</sub>' + m<sub>2</sub>v<sub>2</sub>'</td>
                                    </tr>
                                    <tr class="hover:bg-slate-50 transition-colors border-b border-slate-100">
