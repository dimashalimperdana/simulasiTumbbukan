                    <div class="flex items-center space-x-3">
                        <button id="btn-next" onclick="nextQuestion()" class="px-6 py-2.5 rounded-xl bg-primary hover:bg-indigo-700 text-white font-bold text-sm shadow-md shadow-indigo-500/20 transition-all flex items-center space-x-2">
                            <span>Berikutnya</span>
                            <i class="fa-solid fa-arrow-right text-xs"></i>
                        </button>
                        <button id="btn-submit" onclick="submitQuiz()" class="hidden px-6 py-2.5 rounded-xl bg-emerald-500 hover:bg-emerald-600 text-white font-bold text-sm shadow-md shadow-emerald-500/20 transition-all flex items-center space-x-2">
                            <i class="fa-solid fa-check text-xs"></i>
                            <span>Selesai & Lihat Hasil</span>
                        </button>
                    </div>
                </div>
            </div>

            <!-- RESULT SCREEN CARD (Initially Hidden) -->
            <div id="result-card" class="hidden bg-white/90 backdrop-blur-md rounded-3xl p-6 sm:p-8 shadow-soft border border-slate-200/60 my-auto transition-all">
                
                <!-- Result Header Summary -->
                <div class="text-center pb-8 border-b border-slate-100">
                    <div id="score-icon-bg" class="inline-flex w-20 h-20 items-center justify-center rounded-full bg-cyan-50 border-4 border-white shadow-md mb-4 text-cyan-500">
                        <i id="score-icon" class="fa-solid fa-trophy text-4xl"></i>
                    </div>
                    <h2 id="result-title" class="text-2xl sm:text-3xl font-extrabold text-slate-800 mb-2 tracking-tight">
                        Hasil Kuis Kamu
                    </h2>
                    <p id="result-subtitle" class="text-slate-500 text-sm mb-8 font-medium">
                        Berikut adalah rekapitulasi performa dan pembahasannya
                    </p>

                    <!-- Score Counter Box -->
                    <div class="flex justify-center items-center gap-4 max-w-sm mx-auto">
                        <div class="bg-slate-50 rounded-2xl p-4 border border-slate-100 flex-1 shadow-inner-soft">
                            <span class="text-xs text-slate-400 uppercase tracking-wider font-bold block mb-1">Nilai Akhir</span>
                            <span id="score-percentage" class="text-3xl sm:text-4xl font-extrabold text-primary">100%</span>
                        </div>
                        <div class="bg-slate-50 rounded-2xl p-4 border border-slate-100 flex-1 shadow-inner-soft">
                            <span class="text-xs text-slate-400 uppercase tracking-wider font-bold block mb-1">Benar</span>
                            <span id="score-count" class="text-3xl sm:text-4xl font-extrabold text-emerald-500">3 / 3</span>
                        </div>
                    </div>
                </div>

                <!-- Detailed Explanations Breakdown -->
                <div class="py-8">
                    <h3 class="text-lg font-bold text-slate-800 mb-5 flex items-center space-x-2">
                        <div class="w-8 h-8 rounded-lg bg-indigo-50 text-primary flex items-center justify-center text-sm"><i class="fa-solid fa-book-open"></i></div>
                        <span>Pembahasan & Evaluasi Soal</span>
                    </h3>

                    <div id="explanations-list" class="space-y-6">
                        <!-- Explanations will be populated here dynamically -->
                    </div>
                </div>

                <!-- Restart Action -->
                <div class="pt-6 border-t border-slate-100 flex justify-center">
                    <button onclick="resetQuiz()" class="px-8 py-3.5 rounded-xl bg-primary hover:bg-indigo-700 text-white font-bold text-base shadow-md shadow-indigo-500/25 transition-all flex items-center space-x-2">
                        <i class="fa-solid fa-rotate-right"></i>
                        <span>Ulangi Kuis</span>
                    </button>
                </div>
            </div>
        </div>
    </main>

    <footer class="bg-white border-t border-slate-200/60 py-8 mt-auto relative z-10">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center flex flex-col items-center">
            <div class="flex gap-2 items-center mb-3 text-slate-400 group cursor-pointer hover:text-primary transition-colors">
                <i class="fa-solid fa-atom text-xl group-hover:rotate-180 transition-transform duration-700"></i> 
                <span class="font-bold text-lg">PhyCollide</span>
            </div>
            <p class="text-slate-500 text-sm font-medium">
                &copy; 2026 Pengembangan Media Simulasi Interaktif Berbasis Web untuk Fisika SMA (Fase F).
            </p>
        </div>
    </footer>

    <script>
        // Logika Menu Navigasi
        function toggleMobileMenu() {
            const menu = document.getElementById('mobile-menu');
            menu.classList.toggle('hidden');
        }

        function navigateTo(viewId) {
            const views = document.querySelectorAll('.view-section');
            views.forEach(view => {
                view.classList.add('hidden-view');
                view.classList.remove('fade-in'); // Reset animation
            });

            const targetView = document.getElementById('view-' + viewId);
            if (targetView) {
                targetView.classList.remove('hidden-view');
                // Trigger reflow to restart animation
                void targetView.offsetWidth; 
                targetView.classList.add('fade-in');
                window.scrollTo({ top: 0, behavior: 'smooth' });
            }

            // Update UI Navigasi Desktop
            const navButtons = document.querySelectorAll('.nav-btn');
            navButtons.forEach(btn => {
                if(btn.textContent.toLowerCase().includes(viewId) || (viewId === 'home' && btn.textContent === 'Beranda') || (viewId==='latihan' && btn.textContent.includes('Latihan'))){
                    btn.className = "nav-btn text-primary bg-indigo-50 px-4 py-2 rounded-lg text-sm font-bold shadow-sm transition-all border border-indigo-100";
                } else {
                    btn.className = "nav-btn text-slate-500 hover:text-primary hover:bg-indigo-50 px-4 py-2 rounded-lg text-sm font-semibold transition-all";
                }
            });

            // Update UI Navigasi Mobile
            const mobileBtns = document.querySelectorAll('.mobile-nav-btn');
            mobileBtns.forEach(btn => {
                if(btn.textContent.toLowerCase().includes(viewId) || (viewId === 'home' && btn.textContent === 'Beranda') || (viewId==='latihan' && btn.textContent.includes('Latihan'))){
                    btn.className = "mobile-nav-btn block w-full text-left px-4 py-3 text-base font-bold text-primary bg-indigo-50 rounded-xl border border-indigo-100 transition-colors";
                } else {
                    btn.className = "mobile-nav-btn block w-full text-left px-4 py-3 text-base font-medium text-slate-600 hover:text-primary hover:bg-indigo-50 rounded-xl transition-colors";
                }
            });

            // Re-render MathJax saat tab "Latihan Soal" dibuka agar rumus tampil sempurna
            if (viewId === 'latihan') {
                if (window.MathJax && window.MathJax.typesetPromise) {
                    setTimeout(() => MathJax.typesetPromise(), 50);
                }
            }
        }

        // Variabel Simulasi
        let canvas, ctx;
        let params = { m1:2, v1:4, m2:2, v2:-3, e:1 };
        let b1 = { x:0,y:0,r:0,v:0 };
        let b2 = { x:0,y:0,r:0,v:0 };
        let isRunning=false, animationId, hasCollided=false;
        const pixelsPerMeter=35;

        // Palet warna dari Tailwind (disinkronkan dengan CSS config)
        const COLORS = {
            obj1: '#f43f5e',
            obj1Light: '#fb7185',
            obj2: '#0ea5e9',
            obj2Light: '#38bdf8',
            restitution: '#f59e0b',
            grid: '#f1f5f9',
            gridLine: '#e2e8f0',
            ground: '#cbd5e1',
            text: '#334155'
        };

        function initSimUI() {
            canvas = document.getElementById('simCanvas');
            ctx = canvas.getContext('2d');
            
            const ids = ['m1','v1','m2','v2','e'];
            ids.forEach(id=>{
              document.getElementById(id).addEventListener('input', ()=>{ syncFromNumber(id); onFieldChange(); });
              document.getElementById(id+'_r').addEventListener('input', ()=>{ syncFromRange(id); onFieldChange(); });
            });
            document.querySelectorAll('.e-chip').forEach(btn=>{
              btn.addEventListener('click', ()=>{
                document.getElementById('e').value = btn.dataset.e;
                document.getElementById('e_r').value = btn.dataset.e;
                onFieldChange();
              });
            });
        }

        window.onload = () => {
            initSimUI();
            validateE(); 
            resetSimulation();
        };

        function syncFromNumber(id){
          document.getElementById(id+'_r').value = document.getElementById(id).value;
        }
        function syncFromRange(id){
          document.getElementById(id).value = document.getElementById(id+'_r').value;
        }

        function eLabel(e){
          if(e===1) return {text:'Lenting Sempurna', color:COLORS.restitution};
          if(e===0) return {text:'Tidak Lenting', color:'#64748b'};
          return {text:'Lenting Sebagian', color:'#d97706'};
        }

        function validateE(){
          const e = parseFloat(document.getElementById('e').value);
          const err = document.getElementById('eError');
          const btn = document.getElementById('btnStart');
          const valid = !isNaN(e) && e>=0 && e<=1;
          
          err.classList.toggle('hidden', valid);
          btn.disabled = !valid;
          
          if(valid){
            const info = eLabel(e);
            const lab = document.getElementById('eTypeLabel');
            lab.textContent = info.text;
            lab.style.color = info.color;
            lab.style.borderColor = info.color + '40';
            
            document.querySelectorAll('.e-chip').forEach(c=>{
              const isActive = Math.abs(parseFloat(c.dataset.e)-e) < 0.001;
              c.classList.toggle('active', isActive);
              if(isActive) {
                  c.style.background = info.color;
                  c.style.color = '#fff';
              } else {
                  c.style.background = 'transparent';
                  c.style.color = '#64748b';
              }
            });
          }
          return valid;
        }

        function onFieldChange(){
          validateE();
          resetSimulation();
        }

        function drawCanvas(){
          ctx.clearRect(0,0,canvas.width,canvas.height);
          
          // Gambar Grid Background
          ctx.fillStyle = COLORS.grid;
          ctx.fillRect(0,0, canvas.width, canvas.height);
          
          ctx.strokeStyle = COLORS.gridLine;
          ctx.lineWidth = 1;
          const gridSize = 40;
          
          ctx.beginPath();
          for(let x=0; x<=canvas.width; x+=gridSize) {
              ctx.moveTo(x, 0); ctx.lineTo(x, canvas.height);
          }
          for(let y=0; y<=canvas.height; y+=gridSize) {
              ctx.moveTo(0, y); ctx.lineTo(canvas.width, y);
          }
          ctx.stroke();

          // Garis Landasan
          const groundY = canvas.height/2 + Math.max(b1.r, b2.r) + 10;
          ctx.beginPath();
          ctx.moveTo(0, groundY);
          ctx.lineTo(canvas.width, groundY);
          ctx.strokeStyle = COLORS.ground;
          ctx.lineWidth = 4;
          ctx.stroke();

          // Fungsi Gambar Bola
          function drawBall(b, label, colorMain, colorLight){
            // Bayangan bola
            ctx.beginPath();
            ctx.ellipse(b.x, groundY + 4, b.r*0.8, 4, 0, 0, Math.PI*2);
            ctx.fillStyle = 'rgba(0,0,0,0.1)';
            ctx.fill();

            // Gradient Bola
            let g = ctx.createRadialGradient(b.x-b.r/3,b.y-b.r/3,b.r/5,b.x,b.y,b.r);
            g.addColorStop(0, colorLight);
            g.addColorStop(1, colorMain);
            
            ctx.beginPath(); 
            ctx.arc(b.x, b.y, b.r, 0, Math.PI*2); 
            ctx.fillStyle = g; 
            ctx.fill();
            
            // Border Bola
            ctx.strokeStyle = 'rgba(0,0,0,0.15)'; 
            ctx.lineWidth = 2; 
            ctx.stroke();
            
            // Label Massa
            ctx.fillStyle = 'white'; 
            ctx.font = 'bold 14px Inter, sans-serif'; 
            ctx.textAlign = 'center'; 
            ctx.textBaseline = 'middle';
            ctx.fillText('m'+label, b.x, b.y);

            // Vektor Kecepatan (Panah)
            if(Math.abs(b.v) > 0.1) {
                const maxArrow = 80; // Batas panjang panah visual
                let arrowLength = Math.abs(b.v) * 10;
                if(arrowLength > maxArrow) arrowLength = maxArrow;

                const dir = b.v >= 0 ? 1 : -1;
                const startX = b.x; 
                const startY = b.y - b.r - 20; 
                const endX = b.x + (arrowLength * dir);
                
                ctx.beginPath(); 
                ctx.moveTo(startX, startY); 
                ctx.lineTo(endX, startY);
                ctx.strokeStyle = COLORS.text; 
                ctx.lineWidth = 3; 
                ctx.stroke();
                
                // Kepala Panah
                ctx.beginPath(); 
                ctx.moveTo(endX, startY);
                ctx.lineTo(endX - (10*dir), startY - 5); 
                ctx.lineTo(endX - (10*dir), startY + 5);
                ctx.fillStyle = COLORS.text; 
                ctx.fill();
            }

            // Teks Kecepatan
            ctx.fillStyle = COLORS.text; 
            ctx.font = '600 12px Inter, sans-serif';
            ctx.fillText(b.v.toFixed(1)+' m/s', b.x, b.y - b.r - 35);
          }
          
          // Agar posisi bola di dasar selaras
          b1.y = groundY - b1.r - 2;
          b2.y = groundY - b2.r - 2;

          drawBall(b1, '1', COLORS.obj1, COLORS.obj1Light); 
          drawBall(b2, '2', COLORS.obj2, COLORS.obj2Light);
        }

        function updateLiveReadout(){
          document.getElementById('liveV1').innerHTML = b1.v.toFixed(1) + ' <span class="text-xs font-normal">m/s</span>';
          document.getElementById('liveV2').innerHTML = b2.v.toFixed(1) + ' <span class="text-xs font-normal">m/s</span>';
          const p = (params.m1*b1.v + params.m2*b2.v);
          document.getElementById('liveP').innerHTML = p.toFixed(2) + ' <span class="text-xs font-normal">kg·m/s</span>';
        }

        function setStatus(text, bg, color, icon){
          const el = document.getElementById('statusBadge');
          el.innerHTML = `<i class="fa-solid ${icon}"></i> <span>${text}</span>`;
          el.style.backgroundColor = bg;
          el.style.color = color;
        }

        function resetSimulation(){
          cancelAnimationFrame(animationId);
          isRunning=false; hasCollided=false;
          
          const calcPanel = document.getElementById('calcPanel');
          calcPanel.classList.remove('opacity-100', 'translate-y-0');
          calcPanel.classList.add('opacity-0', 'translate-y-4');
          setTimeout(() => calcPanel.classList.add('hidden'), 500);

          setStatus('Siap Digunakan', 'var(--restitution-soft)', 'var(--restitution)', 'fa-circle-check');
          document.getElementById('btnStart').innerHTML = '<i class="fa-solid fa-play group-hover:scale-110 transition-transform"></i> Mulai Simulasi';

          params.m1 = parseFloat(document.getElementById('m1').value)||0;
          params.v1 = parseFloat(document.getElementById('v1').value)||0;
          params.m2 = parseFloat(document.getElementById('m2').value)||0;
          params.v2 = parseFloat(document.getElementById('v2').value)||0;
          params.e  = parseFloat(document.getElementById('e').value)||0;

          // Mapping jari-jari logaritmik halus agar tidak terlalu besar/kecil
          b1.r = Math.min(Math.max(18 + Math.sqrt(params.m1)*10, 20), 55);
          b2.r = Math.min(Math.max(18 + Math.sqrt(params.m2)*10, 20), 55);

          const margin = 280; // Jarak start dari tengah
          b1.x = (canvas.width/2) - margin;
          b2.x = (canvas.width/2) + margin;
          b1.v = params.v1; b2.v = params.v2;

          drawCanvas();
          updateLiveReadout();
        }

        let lastTime=0;
        function update(timestamp){
          if(!lastTime) lastTime=timestamp;
          const dt=(timestamp-lastTime)/1000;
          lastTime=timestamp;

          if(isRunning){
            b1.x += b1.v*pixelsPerMeter*dt;
            b2.x += b2.v*pixelsPerMeter*dt;

            // Deteksi Tumbukan
            if(!hasCollided && b2.x-b1.x <= (b1.r+b2.r)){
              hasCollided=true;
              
              // Koreksi overlap
              const overlap = (b1.r+b2.r) - (b2.x-b1.x);
              b1.x -= overlap/2; 
              b2.x += overlap/2;

              // Hitung fisika
              const m1=params.m1, v1a=params.v1, m2=params.m2, v2a=params.v2, e=params.e;
              const v1f = ((m1-e*m2)*v1a + m2*(1+e)*v2a)/(m1+m2);
              const v2f = ((m2-e*m1)*v2a + m1*(1+e)*v1a)/(m1+m2);
              
              b1.v = v1f; 
              b2.v = v2f;
              
              // Efek benturan visual (flash layar/badge)
              setStatus('Tumbukan Terjadi!', '#ecfdf5', '#059669', 'fa-burst');
              document.getElementById('btnStart').innerHTML = '<i class="fa-solid fa-rotate-right"></i> Ulangi';
            }
            
            // Hentikan animasi jika bola keluar jauh dari layar
            if(hasCollided && (b1.x < -100 || b1.x > canvas.width+100) && (b2.x < -100 || b2.x > canvas.width+100)) {
                isRunning = false;
                setStatus('Simulasi Selesai', '#f0f9ff', '#0284c7', 'fa-flag-checkered');
            }
          }
          
          drawCanvas();
          updateLiveReadout();
          if(isRunning) animationId = requestAnimationFrame(update);
        }

        function fmt(n){ return (Math.round(n*1000)/1000).toString(); }

        function startSimulation(){
          if(!validateE()) return;
          if(hasCollided) {
              resetSimulation();
              return;
          }
          if(isRunning) return;

          const calcPanel = document.getElementById('calcPanel');
          calcPanel.classList.remove('hidden');
          // Animasi masuk
          setTimeout(() => {
              calcPanel.classList.remove('opacity-0', 'translate-y-4');
              calcPanel.classList.add('opacity-100', 'translate-y-0');
          }, 50);

          const m1=params.m1, v1=params.v1, m2=params.m2, v2=params.v2, e=params.e;
          const info = eLabel(e);

          const pAwal = m1*v1 + m2*v2;
          const v1f = ((m1-e*m2)*v1 + m2*(1+e)*v2)/(m1+m2);
          const v2f = ((m2-e*m1)*v2 + m1*(1+e)*v1)/(m1+m2);
          const pAkhir = m1*v1f + m2*v2f;

          const keAwal = 0.5*m1*v1*v1 + 0.5*m2*v2*v2;
          const keAkhir = 0.5*m1*v1f*v1f + 0.5*m2*v2f*v2f;
          const deltaKE = Math.abs(keAwal - keAkhir);

          const html = `
          <details open class="rounded-xl border bg-white overflow-hidden shadow-sm border-slate-200">
            <summary class="px-4 py-3 text-sm font-bold flex items-center justify-between bg-slate-50 hover:bg-slate-100 transition-colors text-slate-700">
              <span class="flex items-center gap-2"><div class="w-5 h-5 rounded-full bg-slate-200 text-slate-500 flex items-center justify-center text-xs">1</div> Diketahui</span>
              <i class="fa-solid fa-chevron-down text-slate-400 arrow-icon transition-transform"></i>
            </summary>
            <div class="p-4 text-sm text-slate-600 leading-relaxed step-eq bg-white border-t border-slate-100 grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div class="bg-rose-50/50 p-3 rounded-lg border border-rose-100">
                  <span class="font-semibold text-rose-600">Benda 1:</span><br>
                  m₁ = ${fmt(m1)} kg<br>v₁ = ${fmt(v1)} m/s
              </div>
              <div class="bg-sky-50/50 p-3 rounded-lg border border-sky-100">
                  <span class="font-semibold text-sky-600">Benda 2:</span><br>
                  m₂ = ${fmt(m2)} kg<br>v₂ = ${fmt(v2)} m/s
              </div>
              <div class="col-span-full bg-amber-50/50 p-3 rounded-lg border border-amber-100">
                  <span class="font-semibold text-amber-600">Restitusi:</span> e = ${fmt(e)} (${info.text})
              </div>
            </div>
          </details>

          <details open class="rounded-xl border bg-white overflow-hidden shadow-sm border-slate-200">
            <summary class="px-4 py-3 text-sm font-bold flex items-center justify-between bg-slate-50 hover:bg-slate-100 transition-colors text-slate-700">
              <span class="flex items-center gap-2"><div class="w-5 h-5 rounded-full bg-slate-200 text-slate-500 flex items-center justify-center text-xs">2</div> Hukum Kekekalan Momentum</span>
              <i class="fa-solid fa-chevron-down text-slate-400 arrow-icon transition-transform"></i>
            </summary>
            <div class="p-4 text-sm text-slate-600 leading-relaxed step-eq bg-white border-t border-slate-100 space-y-2">
              <div class="bg-slate-50 p-3 rounded-lg">
                  p<sub>awal</sub> = p<sub>akhir</sub><br>
                  m₁v₁ + m₂v₂ = m₁v₁' + m₂v₂'<br>
                  (${fmt(m1)})(${fmt(v1)}) + (${fmt(m2)})(${fmt(v2)}) = ${fmt(m1)}v₁' + ${fmt(m2)}v₂'<br>
              </div>
              <div class="font-bold text-slate-800 bg-indigo-50 p-3 rounded-lg text-center border border-indigo-100">Momentum Total (p) = ${fmt(pAwal)} kg·m/s</div>
            </div>
          </details>

          <details open class="rounded-xl border bg-white overflow-hidden shadow-sm border-slate-200">
            <summary class="px-4 py-3 text-sm font-bold flex items-center justify-between bg-slate-50 hover:bg-slate-100 transition-colors text-slate-700">
              <span class="flex items-center gap-2"><div class="w-5 h-5 rounded-full bg-slate-200 text-slate-500 flex items-center justify-center text-xs">3</div> Persamaan Kecepatan Akhir</span>
              <i class="fa-solid fa-chevron-down text-slate-400 arrow-icon transition-transform"></i>
            </summary>
            <div class="p-4 text-sm text-slate-600 leading-relaxed step-eq bg-white border-t border-slate-100 space-y-4">
                <div>Dari substitusi persamaan momentum dan restitusi didapatkan rumusan:</div>
                <div class="bg-slate-50 p-3 rounded-lg text-center font-semibold overflow-x-auto whitespace-nowrap">
                    v₁' = [(m₁ - e·m₂)v₁ + m₂(1+e)v₂] / (m₁ + m₂)
                </div>
                <div class="bg-rose-50 p-3 rounded-lg border border-rose-100">
                    <div class="mb-2">v₁' = [(${fmt(m1)} - ${fmt(e)}&times;${fmt(m2)})(${fmt(v1)}) + ${fmt(m2)}(1+${fmt(e)})(${fmt(v2)})] / (${fmt(m1)}+${fmt(m2)})</div>
                    <div class="font-extrabold text-lg text-rose-600">v₁' = ${fmt(v1f)} m/s</div>
                </div>
                
                <div class="bg-slate-50 p-3 rounded-lg text-center font-semibold overflow-x-auto whitespace-nowrap">
                    v₂' = [(m₂ - e·m₁)v₂ + m₁(1+e)v₁] / (m₁ + m₂)
                </div>
                <div class="bg-sky-50 p-3 rounded-lg border border-sky-100">
                    <div class="mb-2">v₂' = [(${fmt(m2)} - ${fmt(e)}&times;${fmt(m1)})(${fmt(v2)}) + ${fmt(m1)}(1+${fmt(e)})(${fmt(v1)})] / (${fmt(m1)}+${fmt(m2)})</div>
                    <div class="font-extrabold text-lg text-sky-600">v₂' = ${fmt(v2f)} m/s</div>
                </div>
            </div>
          </details>

          <details class="rounded-xl border bg-white overflow-hidden shadow-sm border-slate-200">
            <summary class="px-4 py-3 text-sm font-bold flex items-center justify-between bg-slate-50 hover:bg-slate-100 transition-colors text-slate-700">
              <span class="flex items-center gap-2"><div class="w-5 h-5 rounded-full bg-slate-200 text-slate-500 flex items-center justify-center text-xs"><i class="fa-solid fa-check"></i></div> Verifikasi Energi</span>
              <i class="fa-solid fa-chevron-down text-slate-400 arrow-icon transition-transform"></i>
            </summary>
            <div class="p-4 text-sm text-slate-600 leading-relaxed step-eq bg-white border-t border-slate-100">
              <ul class="space-y-2 list-disc pl-5">
                  <li>Momentum Akhir (p') = ${fmt(pAkhir)} kg·m/s <span class="${Math.abs(pAkhir-pAwal)<0.01?'text-emerald-500 font-bold':'text-rose-500 font-bold'}">(${Math.abs(pAkhir-pAwal)<0.01?'Terbukti Kekal ✓':'Terdapat Pembulatan'})</span></li>
                  <li>Energi Kinetik Awal (&Sigma;EK) = ${fmt(keAwal)} Joule</li>
                  <li>Energi Kinetik Akhir (&Sigma;EK') = ${fmt(keAkhir)} Joule</li>
                  <li>Energi yang Hilang (&Delta;EK) = <b>${fmt(deltaKE)} Joule</b></li>
              </ul>
            </div>
          </details>
          `;
          document.getElementById('calcContent').innerHTML = html;

          isRunning=true; lastTime=0;
          setStatus('Sedang Bergerak...', '#e0e7ff', '#4f46e5', 'fa-person-running');
          document.getElementById('btnStart').innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Memproses...';
          animationId = requestAnimationFrame(update);
        }

        /* =========================================================
           LOGIKA KUIS / LATIHAN SOAL
           ========================================================= */
        const quizData = [
            {
                id: 1,
                topic: "Tumbukan Lenting Sempurna ($e = 1$)",
                question: "Dua buah benda A dan B bergerak pada lintasan lurus mendatar dan saling mendekati. Benda A bermassa $2\\text{ kg}$ bergerak ke kanan dengan kecepatan $10\\text{ m/s}$, sedangkan benda B bermassa $3\\text{ kg}$ bergerak ke kiri dengan kecepatan $5\\text{ m/s}$. Jika kedua benda mengalami tumbukan <strong>lenting sempurna</strong>, kecepatan masing-masing benda setelah tumbukan adalah...",
                options: [
                    "\\(v_A' = -8\\text{ m/s}\\) dan \\(v_B' = 7\\text{ m/s}\\)",
                    "\\(v_A' = -7\\text{ m/s}\\) dan \\(v_B' = 8\\text{ m/s}\\)",
                    "\\(v_A' = -5\\text{ m/s}\\) dan \\(v_B' = 5\\text{ m/s}\\)",
                    "\\(v_A' = 8\\text{ m/s}\\) dan \\(v_B' = -7\\text{ m/s}\\)",
                    "\\(v_A' = -10\\text{ m/s}\\) dan \\(v_B' = 5\\text{ m/s}\\)"
                ],
                correct: 0,
                explanation: `
                    <div class="space-y-3 text-slate-600 text-sm">
                        <p><strong>Langkah 1: Hukum Kekekalan Momentum</strong><br>
                        Tetapkan arah kanan positif $(+)$ dan kiri negatif $(-)$:
                        $$\\begin{aligned}
                        m_A v_A + m_B v_B &= m_A v_A' + m_B v_B' \\\\
                        2(10) + 3(-5) &= 2 v_A' + 3 v_B' \\\\
                        20 - 15 &= 2 v_A' + 3 v_B' \\\\
                        2 v_A' + 3 v_B' &= 5 \\quad \\text{--- (Persamaan 1)}
                        \\end{aligned}$$
                        </p>
                        <p><strong>Langkah 2: Koefisien Restitusi ($e = 1$)</strong>
                        $$\\begin{aligned}
                        e &= -\\frac{v_B' - v_A'}{v_B - v_A} \\\\
                        1 &= -\\frac{v_B' - v_A'}{-5 - 10} \\implies 1 = \\frac{v_B' - v_A'}{15} \\\\
                        v_B' - v_A' &= 15 \\implies v_B' = v_A' + 15 \\quad \\text{--- (Persamaan 2)}
                        \\end{aligned}$$
                        </p>
                        <p><strong>Langkah 3: Substitusi Persamaan (2) ke (1)</strong>
                        $$\\begin{aligned}
                        2 v_A' + 3(v_A' + 15) &= 5 \\\\
                        2 v_A' + 3 v_A' + 45 &= 5 \\\\
                        5 v_A' &= -40 \\implies v_A' = -8\\text{ m/s} \\quad \\text{(Memantul ke kiri)}
                        \\end{aligned}$$
                        Hitung $v_B'$:
                        $$v_B' = -8 + 15 = 7\\text{ m/s} \\quad \\text{(Memantul ke kanan)}$$
                        </p>
                    </div>
                `
            },
            {
                id: 2,
                topic: "Tumbukan Lenting Sebagian ($0 < e < 1$)",
                question: "Mobil A ($m_A = 1000\\text{ kg}$) bergerak ke kanan dengan kecepatan $20\\text{ m/s}$ dan bertabrakan dengan mobil B ($m_B = 1500\\text{ kg}$) yang bergerak dari arah berlawanan dengan kecepatan $10\\text{ m/s}$. Tumbukan tersebut bersifat <strong>lenting sebagian</strong> dengan koefisien restitusi $e = 0{,}5$. Kecepatan mobil A dan B setelah tumbukan berturut-turut adalah...",
                options: [
                    "\\(v_A' = -8\\text{ m/s}\\) dan \\(v_B' = 7\\text{ m/s}\\)",
                    "\\(v_A' = -7\\text{ m/s}\\) dan \\(v_B' = 8\\text{ m/s}\\)",
                    "\\(v_A' = -5\\text{ m/s}\\) dan \\(v_B' = 10\\text{ m/s}\\)",
                    "\\(v_A' = 7\\text{ m/s}\\) dan \\(v_B' = -8\\text{ m/s}\\)",
                    "\\(v_A' = -10\\text{ m/s}\\) dan \\(v_B' = 5\\text{ m/s}\\)"
                ],
                correct: 1,
                explanation: `
                    <div class="space-y-3 text-slate-600 text-sm">
                        <p><strong>Langkah 1: Hukum Kekekalan Momentum</strong>
                        $$\\begin{aligned}
                        m_A v_A + m_B v_B &= m_A v_A' + m_B v_B' \\\\
                        1000(20) + 1500(-10) &= 1000 v_A' + 1500 v_B' \\\\
                        20000 - 15000 &= 1000 v_A' + 1500 v_B' \\\\
                        5000 &= 1000 v_A' + 1500 v_B' \\quad \\text{(dibagi 500)} \\\\
                        2 v_A' + 3 v_B' &= 10 \\quad \\text{--- (Persamaan 1)}
                        \\end{aligned}$$
                        </p>
                        <p><strong>Langkah 2: Koefisien Restitusi ($e = 0{,}5$)</strong>
                        $$\\begin{aligned}
                        e &= -\\frac{v_B' - v_A'}{v_B - v_A} \\\\
                        0{,}5 &= -\\frac{v_B' - v_A'}{-10 - 20} = \\frac{v_B' - v_A'}{30} \\\\
                        v_B' - v_A' &= 15 \\implies v_B' = v_A' + 15 \\quad \\text{--- (Persamaan 2)}
                        \\end{aligned}$$
                        </p>
                        <p><strong>Langkah 3: Substitusi Persamaan (2) ke (1)</strong>
                        $$\\begin{aligned}
                        2 v_A' + 3(v_A' + 15) &= 10 \\\\
                        5 v_A' + 45 &= 10 \\implies 5 v_A' = -35 \\implies v_A' = -7\\text{ m/s} \\quad \\text{(ke kiri)}
                        \\end{aligned}$$
                        Hitung $v_B'$:
                        $$v_B' = -7 + 15 = 8\\text{ m/s} \\quad \\text{(ke kanan)}$$
                        </p>
                    </div>
                `
            },
            {
                id: 3,
                topic: "Tumbukan Tidak Lenting Sama Sekali ($e = 0$)",
                question: "Sebuah balok kayu bermassa $1{,}98\\text{ kg}$ berada dalam keadaan diam di atas lantai licin. Sebuah peluru bermassa $20\\text{ gram}$ ($0{,}02\\text{ kg}$) ditembakkan secara horizontal hingga menancap ke dalam balok. Jika kecepatan peluru saat mengenai balok adalah $500\\text{ m/s}$, maka kecepatan gabungan balok dan peluru setelah tumbukan adalah...",
                options: [
                    "\\(2{,}5\\text{ m/s}\\)",
                    "\\(5{,}0\\text{ m/s}\\)",
                    "\\(10{,}0\\text{ m/s}\\)",
                    "\\(25{,}0\\text{ m/s}\\)",
                    "\\(50{,}0\\text{ m/s}\\)"
                ],
                correct: 1,
                explanation: `
                    <div class="space-y-3 text-slate-600 text-sm">
                        <p><strong>Konsep Utama:</strong> Karena peluru bersarang di dalam balok, jenis tumbukannya adalah <em>tidak lenting sama sekali</em> ($e = 0$). Kedua benda bergerak bersama setelah tumbukan dengan kecepatan akhir yang sama ($v_A' = v_B' = v'$).</p>
                        <p><strong>Langkah Perhitungan:</strong>
                        $$\\begin{aligned}
                        m_p v_p + m_b v_b &= (m_p + m_b) v' \\\\
                        (0{,}02 \\times 500) + (1{,}98 \\times 0) &= (0{,}02 + 1{,}98) v' \\\\
                        10 + 0 &= 2 v' \\\\
                        2 v' &= 10 \\implies v' = 5\\text{ m/s}
                        \\end{aligned}$$
                        </p>
                        <p>Jadi, kecepatan gabungan balok dan peluru setelah tumbukan adalah <strong>$5{,}0\text{ m/s}$</strong>.</p>
                    </div>
                `
            }
        ];

        let currentQuestion = 0;
        let userAnswers = new Array(quizData.length).fill(null);

        function initQuiz() {
            renderQuestion();
        }

        function renderQuestion() {
            const data = quizData[currentQuestion];
            const currentStep = currentQuestion + 1;
            const totalSteps = quizData.length;
            const percentage = Math.round((currentStep / totalSteps) * 100);

            document.getElementById('question-tracker').textContent = `Soal ${currentStep} dari ${totalSteps}`;
            document.getElementById('progress-percent').textContent = `${percentage}% Selesai`;
            document.getElementById('progress-bar').style.width = `${percentage}%`;

            document.getElementById('topic-tag').innerHTML = data.topic;
            document.getElementById('question-text').innerHTML = data.question;

            const optionsContainer = document.getElementById('options-container');
            optionsContainer.innerHTML = '';
            const labels = ['A', 'B', 'C', 'D', 'E'];

            data.options.forEach((opt, index) => {
                const isSelected = userAnswers[currentQuestion] === index;
                const optionBtn = document.createElement('button');
                
                optionBtn.className = `option-btn w-full p-4 rounded-xl border text-left flex items-start space-x-3 cursor-pointer ${
                    isSelected 
                        ? 'selected border-primary bg-indigo-50/50 shadow-sm text-primary' 
                        : 'border-slate-200 bg-white hover:bg-slate-50 text-slate-600'
                }`;
                optionBtn.onclick = () => selectOption(index);

                optionBtn.innerHTML = `
                    <span class="w-7 h-7 rounded-lg flex items-center justify-center font-bold text-xs shrink-0 transition-colors ${
                        isSelected 
                            ? 'bg-primary text-white' 
                            : 'bg-slate-100 text-slate-500'
                    }">${labels[index]}</span>
                    <span class="flex-1 text-sm font-medium pt-0.5 leading-snug">${opt}</span>
                    <div class="pt-0.5 shrink-0">
                        <i class="fa-regular ${isSelected ? 'fa-circle-check text-primary' : 'fa-circle text-slate-400'} text-base transition-colors"></i>
                    </div>
                `;
                optionsContainer.appendChild(optionBtn);
            });

            document.getElementById('btn-prev').disabled = currentQuestion === 0;

            const btnNext = document.getElementById('btn-next');
            const btnSubmit = document.getElementById('btn-submit');
            if (currentQuestion === quizData.length - 1) {
                btnNext.classList.add('hidden');
                btnSubmit.classList.remove('hidden');
            } else {
                btnNext.classList.remove('hidden');
                btnSubmit.classList.add('hidden');
            }

            if (window.MathJax && window.MathJax.typesetPromise) {
                MathJax.typesetPromise();
            }
        }

        function selectOption(index) {
            userAnswers[currentQuestion] = index;
            renderQuestion();
        }

        function prevQuestion() {
            if (currentQuestion > 0) {
                currentQuestion--;
                renderQuestion();
            }
        }

        function nextQuestion() {
            if (currentQuestion < quizData.length - 1) {
                currentQuestion++;
                renderQuestion();
            }
        }

        function submitQuiz() {
            let correctCount = 0;
            quizData.forEach((item, idx) => {
                if (userAnswers[idx] === item.correct) correctCount++;
            });

            const scorePercent = Math.round((correctCount / quizData.length) * 100);
            
            document.getElementById('quiz-card').classList.add('hidden');
            document.getElementById('result-card').classList.remove('hidden');

            document.getElementById('score-percentage').textContent = `${scorePercent}%`;
            document.getElementById('score-count').textContent = `${correctCount} / ${quizData.length}`;

            const scoreIcon = document.getElementById('score-icon');
            const scoreIconBg = document.getElementById('score-icon-bg');
            const resultTitle = document.getElementById('result-title');
            const resultSubtitle = document.getElementById('result-subtitle');

            if (scorePercent === 100) {
                scoreIcon.className = 'fa-solid fa-trophy text-4xl';
                scoreIconBg.className = 'inline-flex w-20 h-20 items-center justify-center rounded-full bg-amber-50 border-4 border-white shadow-md mb-4 text-amber-500';
                resultTitle.textContent = 'Sempurna! Luar Biasa';
                resultSubtitle.textContent = 'Kamu menguasai seluruh konsep momentum dan tumbukan dengan sangat baik!';
            } else if (scorePercent >= 60) {
                scoreIcon.className = 'fa-solid fa-award text-4xl';
                scoreIconBg.className = 'inline-flex w-20 h-20 items-center justify-center rounded-full bg-cyan-50 border-4 border-white shadow-md mb-4 text-cyan-500';
                resultTitle.textContent = 'Kerja Bagus!';
                resultSubtitle.textContent = 'Hasil yang solid! Pelajari pembahasan di bawah untuk menyempurnakan pemahamanmu.';
            } else {
                scoreIcon.className = 'fa-solid fa-book-bookmark text-4xl';
                scoreIconBg.className = 'inline-flex w-20 h-20 items-center justify-center rounded-full bg-indigo-50 border-4 border-white shadow-md mb-4 text-indigo-500';
                resultTitle.textContent = 'Tetap Semangat!';
                resultSubtitle.textContent = 'Jangan berkecil hati. Simak baik-baik pembahasan di bawah untuk belajar lagi.';
            }

            const expList = document.getElementById('explanations-list');
            expList.innerHTML = '';
            const labels = ['A', 'B', 'C', 'D', 'E'];

            quizData.forEach((item, idx) => {
                const userAns = userAnswers[idx];
                const isCorrect = userAns === item.correct;
                const card = document.createElement('div');
                card.className = `p-5 sm:p-6 rounded-xl border ${
                    isCorrect ? 'bg-emerald-50/50 border-emerald-200' : 'bg-rose-50/50 border-rose-200'
                }`;

                const userText = userAns !== null ? `${labels[userAns]}. ${item.options[userAns]}` : 'Tidak dijawab';
                const correctText = `${labels[item.correct]}. ${item.options[item.correct]}`;

                card.innerHTML = `
                    <div class="flex items-start justify-between gap-3 mb-4">
                        <span class="text-xs font-bold px-2.5 py-1 rounded-md bg-white text-slate-600 border border-slate-200 shadow-sm">
                            Soal #${idx + 1} - ${item.topic}
                        </span>
                        <span class="px-3 py-1 rounded-full text-xs font-bold shadow-sm ${
                            isCorrect ? 'bg-emerald-100 text-emerald-700 border border-emerald-200' : 'bg-rose-100 text-rose-700 border border-rose-200'
                        }">
                            ${isCorrect ? '<i class="fa-solid fa-check mr-1"></i> Benar' : '<i class="fa-solid fa-xmark mr-1"></i> Salah'}
                        </span>
                    </div>

                    <p class="text-slate-800 font-medium text-sm sm:text-base mb-5">${item.question}</p>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-5 text-xs sm:text-sm">
                        <div class="p-3 rounded-lg bg-white border border-slate-200 shadow-sm">
                            <span class="text-slate-500 block text-xs font-bold uppercase mb-1">Jawaban Kamu:</span>
                            <span class="${isCorrect ? 'text-emerald-600 font-bold' : 'text-rose-600 font-bold'}">
                                ${userText}
                            </span>
                        </div>
                        <div class="p-3 rounded-lg bg-white border border-slate-200 shadow-sm">
                            <span class="text-slate-500 block text-xs font-bold uppercase mb-1">Jawaban Benar:</span>
                            <span class="text-emerald-600 font-bold">${correctText}</span>
                        </div>
                    </div>

                    <div class="pt-4 border-t border-slate-200/80">
                        <h4 class="text-xs font-bold text-primary uppercase tracking-wider mb-2 flex items-center">
                            <i class="fa-solid fa-calculator mr-1.5"></i> Pembahasan Langkah Demi Langkah:
                        </h4>
                        ${item.explanation}
                    </div>
                `;
                expList.appendChild(card);
            });

            if (window.MathJax && window.MathJax.typesetPromise) {
                MathJax.typesetPromise();
            }
        }

        function resetQuiz() {
            currentQuestion = 0;
            userAnswers = new Array(quizData.length).fill(null);
            document.getElementById('result-card').classList.add('hidden');
            document.getElementById('quiz-card').classList.remove('hidden');
            renderQuestion();
        }

        // Inisialisasi Kuis saat halaman dimuat
        initQuiz();

    </script>
</body>
</html>
